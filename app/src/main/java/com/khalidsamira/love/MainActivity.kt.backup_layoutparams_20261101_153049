package com.khalidsamira.love

import android.Manifest
import android.app.Activity
import android.content.Intent
import android.content.pm.PackageManager
import android.graphics.Color
import android.graphics.Typeface
import android.graphics.drawable.GradientDrawable
import android.os.Build
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.view.Gravity
import android.view.View
import android.widget.Button
import android.widget.FrameLayout
import android.widget.ImageView
import android.widget.LinearLayout
import android.widget.ScrollView
import android.widget.TextView
import android.widget.Toast

class MainActivity : Activity() {
    private lateinit var statusBadge: TextView
    private lateinit var statusDot: View
    private lateinit var statusDescription: TextView
    private lateinit var actionButton: Button

    private val handler = Handler(Looper.getMainLooper())
    private val bg = Color.rgb(8, 7, 14)
    private val panel = Color.rgb(20, 16, 31)
    private val accent = Color.rgb(167, 139, 250)
    private val accentBright = Color.rgb(196, 181, 253)
    private val textPrimary = Color.rgb(248, 246, 255)
    private val textMuted = Color.rgb(160, 151, 181)
    private val line = Color.rgb(65, 49, 94)
    private val green = Color.rgb(74, 222, 128)

    private val updater = object : Runnable {
        override fun run() {
            refreshState()
            handler.postDelayed(this, 450)
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        window.statusBarColor = bg
        window.navigationBarColor = bg
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
            window.decorView.systemUiVisibility = 0
        }
        buildScreen()
        refreshState()
    }

    private fun buildScreen() {
        val scroll = ScrollView(this).apply {
            setBackgroundResource(R.drawable.kofaxa_background)
            isFillViewport = true
            overScrollMode = View.OVER_SCROLL_NEVER
        }

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.CENTER_HORIZONTAL
            setPadding(dp(24), dp(22), dp(24), dp(22))
        }
        scroll.addView(root, ScrollView.LayoutParams(-1, -1))
        setContentView(scroll)

        // Compact brand header
        val header = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
        }
        val headerLogo = ImageView(this).apply {
            setImageResource(R.drawable.kofaxa_logo)
            scaleType = ImageView.ScaleType.FIT_CENTER
            contentDescription = "KOFAXA"
        }
        header.addView(headerLogo, LinearLayout.LayoutParams(dp(42), dp(42)))

        val brandColumn = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.CENTER_VERTICAL
            setPadding(dp(11), 0, 0, 0)
        }
        val brandName = text("KOFAXA", 17f, textPrimary, true)
        brandName.letterSpacing = 0.17f
        brandColumn.addView(brandName, full())
        val brandCaption = text("PERSONAL WAKE CONTROL", 8f, textMuted, true)
        brandCaption.letterSpacing = 0.16f
        brandColumn.addView(brandCaption, full())
        header.addView(brandColumn, LinearLayout.LayoutParams(0, -2, 1f))

        val version = text("01", 10f, accentBright, true, Gravity.CENTER)
        version.background = rounded(Color.rgb(31, 23, 47), dp(14), line, dp(1))
        header.addView(version, LinearLayout.LayoutParams(dp(38), dp(30)))
        root.addView(header, full())

        addSpace(root, 36)

        // Central emblem with restrained rings
        val emblem = FrameLayout(this)
        emblem.background = rounded(Color.rgb(19, 14, 31), dp(120), Color.rgb(75, 51, 116), dp(1))
        emblem.elevation = dp(8).toFloat()
        val ring = View(this).apply {
            background = rounded(Color.TRANSPARENT, dp(100), Color.rgb(111, 78, 171), dp(1))
        }
        emblem.addView(ring, FrameLayout.LayoutParams(dp(172), dp(172), Gravity.CENTER))
        val innerRing = View(this).apply {
            background = rounded(Color.TRANSPARENT, dp(100), Color.rgb(87, 64, 128), dp(1))
        }
        emblem.addView(innerRing, FrameLayout.LayoutParams(dp(145), dp(145), Gravity.CENTER))
        val heroLogo = ImageView(this).apply {
            setImageResource(R.drawable.kofaxa_logo)
            scaleType = ImageView.ScaleType.FIT_CENTER
            contentDescription = "KOFAXA emblem"
        }
        emblem.addView(heroLogo, FrameLayout.LayoutParams(dp(118), dp(118), Gravity.CENTER))
        root.addView(emblem, LinearLayout.LayoutParams(dp(206), dp(206)))

        addSpace(root, 25)
        val headline = text("WAKE ON YOUR TERMS", 21f, textPrimary, true, Gravity.CENTER)
        headline.letterSpacing = 0.045f
        root.addView(headline, full())
        addSpace(root, 7)
        val subtitle = text("A simple snap. A ready screen.", 13f, textMuted, false, Gravity.CENTER)
        root.addView(subtitle, full())

        addSpace(root, 32)

        // One status panel; no How it works or microphone cards.
        val statusPanel = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            setPadding(dp(18), dp(17), dp(18), dp(17))
            background = rounded(panel, dp(21), line, dp(1))
            elevation = dp(3).toFloat()
        }
        val statusTop = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
        }
        val statusTitle = text("SNAP WAKE", 11f, textMuted, true)
        statusTitle.letterSpacing = 0.13f
        statusTop.addView(statusTitle, LinearLayout.LayoutParams(0, dp(28), 1f))

        val badge = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER
            setPadding(dp(10), 0, dp(10), 0)
            background = rounded(Color.rgb(35, 27, 49), dp(20), Color.rgb(75, 58, 103), dp(1))
        }
        statusDot = View(this).apply {
            background = rounded(Color.rgb(128, 113, 151), dp(9), Color.TRANSPARENT, 0)
        }
        badge.addView(statusDot, LinearLayout.LayoutParams(dp(7), dp(7)))
        statusBadge = text("OFF", 9f, textMuted, true)
        statusBadge.letterSpacing = 0.1f
        badge.addView(statusBadge, LinearLayout.LayoutParams(-2, dp(25)).apply {
            leftMargin = dp(7)
        })
        statusTop.addView(badge, LinearLayout.LayoutParams(-2, dp(29)))
        statusPanel.addView(statusTop, full())

        val separator = View(this).apply { setBackgroundColor(line) }
        statusPanel.addView(separator, LinearLayout.LayoutParams(-1, dp(1)).apply {
            topMargin = dp(10)
            bottomMargin = dp(11)
        })
        statusDescription = text("Snap wake is paused", 13f, textPrimary, true)
        statusPanel.addView(statusDescription, full())
        root.addView(statusPanel, full())

        addSpace(root, 15)
        actionButton = Button(this).apply {
            textSize = 14f
            isAllCaps = false
            typeface = Typeface.create("sans-serif", Typeface.BOLD)
            letterSpacing = 0.035f
            gravity = Gravity.CENTER
            setPadding(dp(18), 0, dp(18), 0)
            minHeight = 0
            minimumHeight = 0
            stateListAnimator = null
            background = rounded(accent, dp(18), accentBright, dp(1))
            setTextColor(Color.rgb(18, 12, 30))
            setOnClickListener {
                if (SnapWakeService.isActive) disableSnapWake() else enableSnapWake()
            }
        }
        root.addView(actionButton, LinearLayout.LayoutParams(-1, dp(58)))

        addSpace(root, 19)
        val footer = text("KOFAXA  \u2022  MADE FOR YOUR EVERYDAY", 9f, textMuted, true, Gravity.CENTER)
        footer.letterSpacing = 0.12f
        root.addView(footer, full())
    }

    private fun enableSnapWake() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M &&
            checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED
        ) {
            requestPermissions(arrayOf(Manifest.permission.RECORD_AUDIO), 1001)
            return
        }
        try {
            val intent = Intent(this, SnapWakeService::class.java).apply {
                action = SnapWakeService.ACTION_START
            }
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) startForegroundService(intent)
            else startService(intent)
        } catch (e: Exception) {
            Toast.makeText(this, "Could not start KOFAXA: ${e.message}", Toast.LENGTH_LONG).show()
        }
        refreshState()
    }

    private fun disableSnapWake() {
        val intent = Intent(this, SnapWakeService::class.java).apply {
            action = SnapWakeService.ACTION_STOP
        }
        try {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) startForegroundService(intent)
            else startService(intent)
        } catch (_: Exception) {
        }
        refreshState()
    }

    override fun onRequestPermissionsResult(
        requestCode: Int,
        permissions: Array<out String>,
        grantResults: IntArray
    ) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults)
        if (requestCode == 1001) {
            if (grantResults.isNotEmpty() && grantResults[0] == PackageManager.PERMISSION_GRANTED) {
                enableSnapWake()
            } else {
                Toast.makeText(this, "Sound permission is needed to recognize a snap.", Toast.LENGTH_LONG).show()
            }
        }
    }

    override fun onResume() {
        super.onResume()
        refreshState()
        handler.removeCallbacks(updater)
        handler.post(updater)
    }

    override fun onPause() {
        handler.removeCallbacks(updater)
        super.onPause()
    }

    private fun refreshState() {
        if (!::actionButton.isInitialized) return
        val active = SnapWakeService.isActive
        statusDot.background = rounded(
            if (active) green else Color.rgb(128, 113, 151), dp(9), Color.TRANSPARENT, 0
        )
        statusBadge.text = if (active) "ACTIVE" else "OFF"
        statusBadge.setTextColor(if (active) green else textMuted)
        statusDescription.text = if (active) "Your phone is ready for a snap" else "Snap wake is paused"
        actionButton.text = if (active) "PAUSE SNAP WAKE" else "ACTIVATE SNAP WAKE"
        actionButton.background = rounded(
            if (active) accentBright else accent,
            dp(18),
            Color.rgb(218, 206, 255),
            dp(1)
        )
    }

    private fun text(
        value: String,
        size: Float,
        color: Int,
        bold: Boolean = false,
        gravity: Int = Gravity.CENTER_VERTICAL
    ) = TextView(this).apply {
        text = value
        textSize = size
        setTextColor(color)
        typeface = if (bold) Typeface.DEFAULT_BOLD else Typeface.DEFAULT
        this.gravity = gravity
        includeFontPadding = false
    }

    private fun rounded(fill: Int, radius: Int, stroke: Int, strokeWidth: Int) =
        GradientDrawable().apply {
            setColor(fill)
            cornerRadius = radius.toFloat()
            if (strokeWidth > 0) setStroke(strokeWidth, stroke)
        }

    private fun addSpace(parent: LinearLayout, height: Int) {
        parent.addView(View(this), LinearLayout.LayoutParams(1, dp(height)))
    }

    private fun full() = LinearLayout.LayoutParams(-1, -2)
    private fun dp(value: Int) = (value * resources.displayMetrics.density).toInt()
}
