
package com.khalidsamira.love

import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Context
import android.content.Intent
import android.media.AudioFormat
import android.media.AudioRecord
import android.media.MediaRecorder
import android.os.Build
import android.os.IBinder
import android.os.PowerManager
import kotlin.concurrent.thread
import kotlin.math.sqrt

class SnapWakeService : Service() {

    companion object {
        const val ACTION_START = "com.khalidsamira.love.START_SNAP"
        const val ACTION_STOP = "com.khalidsamira.love.STOP_SNAP"

        @Volatile
        var isActive: Boolean = false
            private set

        private const val CHANNEL_ID = "snap_wake_channel"
        private const val NOTIFICATION_ID = 731
        private const val SAMPLE_RATE = 16000
    }

    @Volatile private var running = false
    @Volatile private var recorder: AudioRecord? = null

    override fun onCreate() {
        super.onCreate()
        createNotificationChannel()
        startForegroundCompat()
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        when (intent?.action) {
            ACTION_STOP -> {
                stopSelf()
                return START_NOT_STICKY
            }

            ACTION_START, null -> startListening()
        }

        return START_NOT_STICKY
    }

    private fun startForegroundCompat() {
        val notification = Notification.Builder(this, CHANNEL_ID)
            .setSmallIcon(android.R.drawable.ic_lock_silent_mode_off)
            .setContentTitle("KOFAXA")
            .setContentText("Snap wake is active")
            .setCategory(Notification.CATEGORY_SERVICE)
            .setOngoing(true)
            .build()

        startForeground(NOTIFICATION_ID, notification)
    }

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                CHANNEL_ID,
                "Snap to Wake",
                NotificationManager.IMPORTANCE_LOW
            )

            channel.description = "Keeps finger snap detection active"

            getSystemService(NotificationManager::class.java)
                .createNotificationChannel(channel)
        }
    }

    private fun startListening() {
        if (running) return

        val minBuffer = AudioRecord.getMinBufferSize(
            SAMPLE_RATE,
            AudioFormat.CHANNEL_IN_MONO,
            AudioFormat.ENCODING_PCM_16BIT
        )

        if (minBuffer <= 0) {
            isActive = false
            stopSelf()
            return
        }

        val audio = try {
            AudioRecord(
                MediaRecorder.AudioSource.MIC,
                SAMPLE_RATE,
                AudioFormat.CHANNEL_IN_MONO,
                AudioFormat.ENCODING_PCM_16BIT,
                maxOf(minBuffer * 2, 4096)
            )
        } catch (e: Exception) {
            android.util.Log.e("SnapWakeService", "Could not create AudioRecord", e)
            isActive = false
            stopSelf()
            return
        }

        if (audio.state != AudioRecord.STATE_INITIALIZED) {
            audio.release()
            isActive = false
            stopSelf()
            return
        }

        recorder = audio
        running = true
        isActive = true

        getSharedPreferences("wake_settings", MODE_PRIVATE)
            .edit()
            .putBoolean("snap_enabled", true)
            .apply()

        thread(name = "SnapAudioDetector") {
            detectSnaps(audio)
        }
    }

    private fun detectSnaps(audio: AudioRecord) {
        // 512 samples = 32 ms at 16 kHz.
        // Eight 4 ms subframes help identify a short, concentrated impulse.
        val samples = ShortArray(512)
        val chunkEnergy = DoubleArray(8)
        val chunkSamples = IntArray(8)

        var lastAccepted = 0L
        var armed = true
        var quietFrames = 0
        var noiseFloor = 220.0

        try {
            audio.startRecording()

            while (running) {
                val count = audio.read(samples, 0, samples.size)
                if (count <= 0) continue

                var sumSquares = 0.0
                var differenceSquares = 0.0
                var peak = 0
                var previous = samples[0].toInt()

                java.util.Arrays.fill(chunkEnergy, 0.0)
                java.util.Arrays.fill(chunkSamples, 0)

                for (i in 0 until count) {
                    val value = samples[i].toInt()
                    val absolute = kotlin.math.abs(value)

                    if (absolute > peak) peak = absolute

                    sumSquares += value.toDouble() * value.toDouble()

                    if (i > 0) {
                        val difference = (value - previous).toDouble()
                        differenceSquares += difference * difference
                    }

                    previous = value

                    val chunk = (i / 64).coerceAtMost(7)
                    chunkEnergy[chunk] += value.toDouble() * value.toDouble()
                    chunkSamples[chunk]++
                }

                val rms = sqrt(sumSquares / count)
                val crest = peak / maxOf(rms, 1.0)

                // A snap should be concentrated in a very short part of the frame.
                var maxChunkIndex = 0
                for (i in 1 until 8) {
                    if (chunkEnergy[i] > chunkEnergy[maxChunkIndex]) {
                        maxChunkIndex = i
                    }
                }

                val maxChunkRms = sqrt(
                    chunkEnergy[maxChunkIndex] /
                        maxOf(chunkSamples[maxChunkIndex], 1)
                )

                var otherChunkRmsTotal = 0.0
                var otherChunkCount = 0

                for (i in 0 until 8) {
                    if (i != maxChunkIndex && chunkSamples[i] > 0) {
                        otherChunkRmsTotal += sqrt(
                            chunkEnergy[i] / chunkSamples[i]
                        )
                        otherChunkCount++
                    }
                }

                val otherChunkAverage =
                    if (otherChunkCount > 0) {
                        otherChunkRmsTotal / otherChunkCount
                    } else {
                        0.0
                    }

                val burstRatio =
                    maxChunkRms / maxOf(otherChunkAverage, noiseFloor)

                // High-frequency changes are characteristic of sharp impulses.
                val highFrequencyRatio =
                    differenceSquares / maxOf(sumSquares, 1.0)

                val now = System.currentTimeMillis()

                val looksLikeSnap =
                    peak >= 8500 &&
                    rms >= 500 &&
                    crest >= 4.5 &&
                    highFrequencyRatio >= 0.85 &&
                    burstRatio >= 2.2 &&
                    rms >= maxOf(noiseFloor * 2.5, 500.0)

                // Adapt to quiet environmental noise without following loud speech.
                if (rms < maxOf(noiseFloor * 1.8, 700.0)) {
                    noiseFloor = noiseFloor * 0.94 + rms * 0.06
                } else if (rms < 1000.0) {
                    noiseFloor = noiseFloor * 0.995 + rms * 0.005
                }

                if (looksLikeSnap && armed && now - lastAccepted >= 700L) {
                    armed = false
                    lastAccepted = now

                    android.util.Log.i(
                        "SnapWakeService",
                        "SNAP_CANDIDATE peak=$peak rms=${rms.toInt()} " +
                            "crest=${"%.2f".format(crest)} " +
                            "hf=${"%.2f".format(highFrequencyRatio)} " +
                            "burst=${"%.2f".format(burstRatio)}"
                    )

                    // One detected snap wakes the screen.
                    wakeScreen()
                }

                // Require a quiet interval before accepting another snap.
                if (rms < maxOf(noiseFloor * 1.8, 650.0)) {
                    quietFrames++
                    if (quietFrames >= 6) {
                        armed = true
                    }
                } else {
                    quietFrames = 0
                }
            }
        } catch (e: Exception) {
            if (running) {
                android.util.Log.e("SnapWakeService", "Audio detection failed", e)
                running = false
                isActive = false

                getSharedPreferences("wake_settings", MODE_PRIVATE)
                    .edit()
                    .putBoolean("snap_enabled", false)
                    .apply()

                stopSelf()
            }
        } finally {
            try {
                if (audio.recordingState == AudioRecord.RECORDSTATE_RECORDING) {
                    audio.stop()
                }
            } catch (_: Exception) {
            }

            audio.release()
            recorder = null
        }
    }


    @Suppress("DEPRECATION")
    private fun wakeScreen() {
        val power =
            getSystemService(Context.POWER_SERVICE) as PowerManager

        if (!power.isInteractive) {
            val lock = power.newWakeLock(
                PowerManager.SCREEN_BRIGHT_WAKE_LOCK or
                    PowerManager.ACQUIRE_CAUSES_WAKEUP or
                    PowerManager.ON_AFTER_RELEASE,
                "KhalidSamiraLove:SnapWake"
            )

            try {
                lock.acquire(3000)
            } catch (_: Exception) {
            }
        }
    }

    override fun onDestroy() {
        running = false
        isActive = false

        try {
            recorder?.stop()
        } catch (_: Exception) {
        }

        getSharedPreferences("wake_settings", MODE_PRIVATE)
            .edit()
            .putBoolean("snap_enabled", false)
            .apply()

        super.onDestroy()
    }

    override fun onBind(intent: Intent?): IBinder? = null
}

