
package com.khalidsamira.love

import android.Manifest
import android.app.Activity
import android.content.Intent
import android.content.pm.PackageManager
import android.graphics.Color
import android.graphics.Typeface
import android.graphics.drawable.GradientDrawable
import android.os.Build
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.view.Gravity
import android.view.View
import android.widget.Button
import android.widget.LinearLayout
import android.widget.ScrollView
import android.widget.TextView
import android.widget.Toast

class MainActivity : Activity() {
    private val prefs by lazy { getSharedPreferences("wake_settings", MODE_PRIVATE) }
    private lateinit var statusText: TextView
    private lateinit var statusDot: TextView
    private lateinit var toggleButton: Button
    private lateinit var listeningCard: LinearLayout
    private var enabled = false
    private var theme = "romantic"
    private val handler = Handler(Looper.getMainLooper())

    private val updater = object : Runnable {
        override fun run() {
            val active = SnapWakeService.isActive
            if (enabled != active) {
                enabled = active
                prefs.edit().putBoolean("snap_enabled", active).apply()
                refreshState()
            }

            val saved = prefs.getString("app_theme", "romantic") ?: "romantic"
            if (saved != theme) {
                theme = saved
                buildScreen()
                refreshState()
            }
            handler.postDelayed(this, 400)
        }
    }

    private val mono get() = theme == "youssef"
    private val accent get() = if (mono) Color.WHITE else Color.rgb(255, 65, 137)
    private val secondary get() = if (mono) Color.rgb(205, 205, 205) else Color.rgb(255, 177, 205)
    private val gold get() = if (mono) Color.WHITE else Color.rgb(244, 204, 139)
    private val muted get() = if (mono) Color.rgb(155, 155, 155) else Color.rgb(190, 151, 169)
    private val border get() = if (mono) Color.rgb(75, 75, 75) else Color.rgb(105, 42, 70)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        theme = prefs.getString("app_theme", "romantic") ?: "romantic"
        enabled = SnapWakeService.isActive
        buildScreen()
        refreshState()
    }

    private fun buildScreen() {
        val scroll = ScrollView(this).apply {
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                if (mono) intArrayOf(Color.BLACK, Color.rgb(20,20,20), Color.rgb(5,5,5))
                else intArrayOf(Color.rgb(8,5,10), Color.rgb(22,7,16), Color.rgb(9,5,10))
            )
            isFillViewport = true
        }

        val root = LinearLayout(this).apply {
            orientation = LinearLayout.VERTICAL
            gravity = Gravity.CENTER_HORIZONTAL
            setPadding(dp(22), dp(22), dp(22), dp(28))
        }

        scroll.addView(root)
        setContentView(scroll)

        val switch = Button(this).apply {
            text = if (mono) "Switch to ROMANTIC  ♥" else "Switch to YOUSSEF  ◐"
            textSize = 13f
            isAllCaps = false
            typeface = Typeface.DEFAULT_BOLD
            setTextColor(if (mono) Color.BLACK else Color.WHITE)
            background = rounded(
                if (mono) Color.WHITE else Color.rgb(100,20,52),
                24, accent, 1
            )
            setOnClickListener { switchTheme() }
        }

        root.addView(
            switch,
            LinearLayout.LayoutParams(-2, dp(46)).apply {
                gravity = Gravity.CENTER
            }
        )

        space(root, 20)

        if (mono) {
            root.addView(
                label("YOUSSEF", 39f, Color.WHITE, true, Gravity.CENTER, 76),
                full()
            )
            root.addView(
                label("S N A P   /   W A K E", 13f, muted, true, Gravity.CENTER),
                full()
            )
        } else {
            root.addView(
                label("♡", 76f, accent, true, Gravity.CENTER),
                full()
            )
            root.addView(
                label("KHALID  +  SAMIRA", 29f, gold, true, Gravity.CENTER),
                full()
            )
            root.addView(
                label("= LOVE =", 42f, accent, true, Gravity.CENTER, 62),
                full()
            )
        }

        space(root, 26)

        val main = card()
        root.addView(main, full())

        main.addView(
            label(if (mono) "◉   SNAP TO WAKE" else "♥   SNAP TO WAKE", 23f, secondary, true),
            full()
        )

        space(main, 8)

        main.addView(
            label("Wake your phone with a simple finger snap", 15f, Color.WHITE),
            full()
        )

        space(main, 18)

        val row = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
        }

        statusDot = label("●", 18f, Color.GREEN, true)
        statusText = label("Snap detection is off", 14f, muted, true)

        row.addView(statusDot)
        row.addView(
            statusText,
            LinearLayout.LayoutParams(0, dp(32), 1f).apply {
                leftMargin = dp(10)
            }
        )

        main.addView(row, full())
        space(main, 16)

        toggleButton = Button(this).apply {
            textSize = 16f
            isAllCaps = false
            typeface = Typeface.DEFAULT_BOLD
            setPadding(dp(12), dp(12), dp(12), dp(12))
            elevation = dp(4).toFloat()

            setOnClickListener {
                if (SnapWakeService.isActive) {
                    disableSnapWake()
                } else {
                    enableSnapWake()
                }
            }
        }

        main.addView(toggleButton, LinearLayout.LayoutParams(-1, dp(58)))

        space(root, 16)

        listeningCard = card()
        root.addView(listeningCard, full())

        listeningCard.addView(
            label(if (mono) "MIC" else "🎙", 30f, accent, true, Gravity.CENTER),
            full()
        )

        space(listeningCard, 8)

        listeningCard.addView(
            label("MICROPHONE STATUS", 17f, secondary, true, Gravity.CENTER),
            full()
        )

        listeningCard.addView(
            label(
                "The microphone listens for finger snaps only while Snap to Wake is enabled.",
                14f, muted, false, Gravity.CENTER
            ),
            full()
        )

        space(root, 16)

        val instructions = card()
        root.addView(instructions, full())

        instructions.addView(label("HOW TO USE", 18f, gold, true), full())
        space(instructions, 12)

        listOf(
            "01   Enable Snap to Wake.",
            "02   Allow microphone permission.",
            "03   Turn off your phone screen.",
            "04   One snap wakes the screen.",
            "05   Two quick snaps switch the theme."
        ).forEach {
            instructions.addView(label(it, 14f, Color.WHITE), full())
        }

        space(root, 24)

        root.addView(
            label(
                if (mono) "BY YOUSSEF" else "♡     By Youssef     ♡",
                23f, gold, mono, Gravity.CENTER
            ),
            full()
        )

        if (!mono) {
            space(root, 8)
            root.addView(
                label("KHALID + SAMIRA = LOVE", 11f, muted, true, Gravity.CENTER),
                full()
            )
        }
    }

    private fun switchTheme() {
        theme = if (theme == "romantic") "youssef" else "romantic"
        prefs.edit().putString("app_theme", theme).apply()
        buildScreen()
        refreshState()

        Toast.makeText(
            this,
            if (mono) "YOUSSEF theme enabled" else "Romantic theme enabled",
            Toast.LENGTH_SHORT
        ).show()
    }

    private fun enableSnapWake() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M &&
            checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED
        ) {
            requestPermissions(arrayOf(Manifest.permission.RECORD_AUDIO), 1001)
            return
        }

        try {
            val intent = Intent(this, SnapWakeService::class.java).apply {
                action = SnapWakeService.ACTION_START
            }

            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                startForegroundService(intent)
            } else {
                startService(intent)
            }

            Toast.makeText(this, "Snap to Wake starting...", Toast.LENGTH_SHORT).show()
        } catch (e: Exception) {
            Toast.makeText(
                this,
                "Could not start Snap to Wake: ${e.message}",
                Toast.LENGTH_LONG
            ).show()
        }
    }

    private fun disableSnapWake() {
        val intent = Intent(this, SnapWakeService::class.java).apply {
            action = SnapWakeService.ACTION_STOP
        }

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            startForegroundService(intent)
        } else {
            startService(intent)
        }

        enabled = false
        prefs.edit().putBoolean("snap_enabled", false).apply()
        refreshState()
    }

    override fun onRequestPermissionsResult(
        requestCode: Int,
        permissions: Array<out String>,
        grantResults: IntArray
    ) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults)

        if (requestCode == 1001) {
            if (grantResults.isNotEmpty() &&
                grantResults[0] == PackageManager.PERMISSION_GRANTED
            ) {
                enableSnapWake()
            } else {
                Toast.makeText(
                    this,
                    "Microphone permission is required.",
                    Toast.LENGTH_LONG
                ).show()
            }
        }
    }

    override fun onResume() {
        super.onResume()
        enabled = SnapWakeService.isActive
        if (::toggleButton.isInitialized) refreshState()
        handler.removeCallbacks(updater)
        handler.post(updater)
    }

    override fun onPause() {
        handler.removeCallbacks(updater)
        super.onPause()
    }

    private fun refreshState() {
        if (!::toggleButton.isInitialized) return

        enabled = SnapWakeService.isActive

        statusDot.setTextColor(
            if (enabled) Color.rgb(58,220,126)
            else if (mono) Color.GRAY else Color.rgb(130,110,122)
        )

        statusText.text =
            if (enabled) "Listening for a snap..."
            else "Snap detection is off"

        statusText.setTextColor(
            if (enabled) Color.rgb(135,245,174) else muted
        )

        toggleButton.text =
            if (enabled) "Disable Snap to Wake"
            else "Enable Snap to Wake"

        toggleButton.setTextColor(if (mono) Color.BLACK else Color.WHITE)

        toggleButton.background = rounded(
            if (enabled) {
                if (mono) Color.LTGRAY else Color.rgb(143,15,57)
            } else accent,
            32, secondary, 2
        )

        listeningCard.alpha = if (enabled) 1f else 0.78f
    }

    private fun card() = LinearLayout(this).apply {
        orientation = LinearLayout.VERTICAL
        setPadding(dp(20), dp(20), dp(20), dp(20))

        background = GradientDrawable(
            GradientDrawable.Orientation.TL_BR,
            if (mono) {
                intArrayOf(
                    Color.rgb(34,34,34),
                    Color.rgb(18,18,18),
                    Color.rgb(27,27,27)
                )
            } else {
                intArrayOf(
                    Color.rgb(48,17,34),
                    Color.rgb(27,10,21),
                    Color.rgb(37,12,25)
                )
            }
        ).apply {
            cornerRadius = dp(24).toFloat()
            setStroke(dp(1), border)
        }

        elevation = dp(7).toFloat()
    }

    private fun label(
        value: String,
        size: Float,
        color: Int,
        bold: Boolean = false,
        gravity: Int = Gravity.CENTER_VERTICAL,
        height: Int = -2
    ) = TextView(this).apply {
        text = value
        textSize = size
        setTextColor(color)
        typeface = if (bold) Typeface.DEFAULT_BOLD else Typeface.DEFAULT
        this.gravity = gravity
        if (height > 0) minHeight = dp(height)
    }

    private fun rounded(
        color: Int,
        radius: Int,
        strokeColor: Int,
        strokeWidth: Int
    ) = GradientDrawable().apply {
        setColor(color)
        cornerRadius = dp(radius).toFloat()
        setStroke(dp(strokeWidth), strokeColor)
    }

    private fun space(parent: LinearLayout, height: Int) {
        parent.addView(View(this), LinearLayout.LayoutParams(1, dp(height)))
    }

    private fun full() =
        LinearLayout.LayoutParams(-1, -2)

    private fun dp(value: Int) =
        (value * resources.displayMetrics.density).toInt()
}

